# ════════════════════════════════════════════════════════════════
# AKP 프로젝트 API 키 템플릿
# ─────────────────────────────────────────────────────────────
# 사용법:  cp .env.example .env  후 실제 값으로 교체
# ⚠️  .env 파일은 절대 GitHub에 커밋하지 마세요. (.env.example만 커밋)
# ════════════════════════════════════════════════════════════════

# Anthropic API (Claude 비전 구조화·검증 — 필수)
# 발급: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx_your_claude_key_here

# Gemini API (그림 재작도 — 없으면 재작도 기능만 비활성)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Mathpix API (선택 — 현재 흐름 미사용, health 표시용)
MATHPIX_APP_ID=your_mathpix_app_id_here
MATHPIX_APP_KEY=your_mathpix_app_key_here

# Google OAuth (로그인 + Drive 업로드)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
SECRET_KEY=change-me-session-secret
ADMIN_EMAIL=admin@example.com

# 웹 서비스 설정
DAILY_COST_CAP=5.0

# Railway 배포 시 Volume 마운트 경로 (로컬에서는 비워둠)
DATA_DIR=
