# ════════════════════════════════════════════════════════════════
# ⚠️  API 키 / 환경 변수 — 절대 커밋 금지
# ════════════════════════════════════════════════════════════════
.env
.env.*
*.env.bak
# .env.example 은 커밋 허용 (템플릿 파일)
!.env.example

# API 키·자격증명 파일
secrets/
credentials/
*.key
*.pem
*.p12
*.pfx

# ─── 웹 서버 런타임 데이터 ────────────────────────────────────
# 변환 작업 폴더(3일 자동 정리) · 로그 · 업로드 · 토큰
scripts/web/data/work/
scripts/web/data/tmp/
scripts/web/data/uploads/
scripts/web/data/gdrive_token.json
scripts/web/data/users.json
scripts/web/data/usage.jsonl
scripts/web/data/matrix_registry.json
scripts/web/logs/
scripts/web/tmp/
# matrix_config.json 은 시드로 커밋 허용

# ─── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ─── Frontend ─────────────────────────────────────────────────
frontend/node_modules/
# frontend/dist 는 배포용으로 커밋한다 (Railway 에 node 빌드 없음)

# ─── 백업·임시 파일 ────────────────────────────────────────────
*.bak
*.bak[0-9]*
_unpacked/
_temp/
output/

# ─── IDE / OS ─────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
